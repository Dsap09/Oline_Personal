{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/keepalive.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "^/api/keepalive/?$",
      "dest": "/api/keepalive.py"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.py"
    }
  ]
}
